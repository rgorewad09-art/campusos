# ==============================================================================
# CampusOS Environment Variables (Example)
#
# Copy this file to .env.local and fill in your Supabase project credentials.
# Never commit .env.local or real API keys to Git.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon API Key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Supabase Service Role Secret Key (SERVER-ONLY: Used for Auth email invitations)
# WARNING: Never add NEXT_PUBLIC_ prefix or expose this key to browser client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public Application URL (e.g. https://campusos.vercel.app or custom domain)
# Optional in local development (defaults to http://localhost:3000).
# On Vercel, automatically falls back to VERCEL_URL if omitted.
NEXT_PUBLIC_APP_URL=https://campusos.vercel.app
